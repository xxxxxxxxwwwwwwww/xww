        return;
      }
      
      answeredQuestions[currentChoiceQuestion.id] = selectedAnswer;
      
      // 更新选项样式
      document.querySelectorAll('.choice-option').forEach(opt => {
        opt.classList.add('disabled');
        if (opt.dataset.label === currentChoiceQuestion.answer) {
          opt.classList.add('correct');
        } else if (opt.dataset.label === selectedAnswer && selectedAnswer !== currentChoiceQuestion.answer) {
          opt.classList.add('wrong');
        }
      });
      
      // 禁用提交按钮，显示解析按钮
      document.getElementById('submit-choice-btn').disabled = true;
      document.getElementById('submit-choice-btn').style.opacity = '0.5';
      document.getElementById('submit-choice-btn').style.cursor = 'not-allowed';
      document.getElementById('show-analysis-btn').style.display = 'flex';
      
      // 更新答案解析
      updateChoiceAnalysis();
    }

    // 显示选择题解析
    function showChoiceAnalysis() {
      if (!answeredQuestions[currentChoiceQuestion.id]) {
        alert('请先提交答案');
        return;
      }
      document.getElementById('answer-analysis').scrollIntoView({ behavior: 'smooth' });
    }

    // 更新选择题解析内容
    function updateChoiceAnalysis() {
      if (!currentChoiceQuestion) return;
      
      const isAnswered = !!answeredQuestions[currentChoiceQuestion.id];
      const isCorrect = selectedAnswer === currentChoiceQuestion.answer;
      
      let contentHtml;
      if (!isAnswered) {
        contentHtml = \`
          <div class="bg-amber-900 bg-opacity-20 border border-amber-700 rounded-lg p-4 mb-4">
            <p class="text-amber-400"><i class="fa fa-info-circle"></i> 请先选择一个答案，然后点击"提交答案"查看解析</p>
          </div>
        \`;
      } else {
        contentHtml = \`
          <div class="mb-4">
            <p class="text-gray-300 mb-2">正确答案：<span class="text-emerald-400 font-bold">\${currentChoiceQuestion.answer}</span></p>
            <p class="text-gray-300">您的答案：\${selectedAnswer ? \`<span class="\${isCorrect ? 'text-emerald-400' : 'text-red-400'} font-bold">\${selectedAnswer}</span>\` : '<span class="text-gray-500">未作答</span>'}</p>
          </div>
          <div class="bg-dark p-4 rounded-lg mb-4">
            <h5 class="text-cyan-400 font-semibold mb-2">解析</h5>
            <p class="text-gray-300">\${currentChoiceQuestion.analysis}</p>
          </div>
          <h4>相关知识点</h4>
          <ul class="list-disc list-inside space-y-1 mt-2">
            <li><a href="#" class="text-cyan-400 hover:underline" onclick="showTab('knowledge'); scrollToKnowledge('\${getKnowledgeSection(currentChoiceQuestion.chapter)}')">\${getChapterName(currentChoiceQuestion.chapter)}</a></li>
          </ul>
        \`;
      }
      
      document.getElementById('answer-analysis').innerHTML = \`
        <h4>答案解析</h4>
        \${contentHtml}
      \`;
    }

    // 获取知识点章节ID
    function getKnowledgeSection(chapter) {
      const sections = {
        1: 'module1-database',
        2: 'module2-sql',
        3: 'module3-design',
        4: 'module4-management',
        5: 'module5-advanced',
        6: 'module5-advanced'
      };
      return sections[chapter] || 'module1-database';
    }

    // 获取章节名称
    function getChapterName(chapter) {
      const names = {
        1: '数据库基础',
        2: 'SQL语言',
        3: '数据库设计',
        4: '数据库管理',
        5: '高级话题',
        6: '高级话题'
      };
      return names[chapter] || '数据库基础';
    }

    // 切换代码编辑器折叠
    function toggleCodeEditor() {
      const codeContainer = document.getElementById('code-editor-container');
      const icon = document.getElementById('toggle-code-icon');
      
      if (isCodeEditorCollapsed) {
        codeContainer.style.display = 'block';
        icon.classList.remove('fa-chevron-down');
        icon.classList.add('fa-chevron-up');
      } else {
        codeContainer.style.display = 'none';
        icon.classList.remove('fa-chevron-up');
        icon.classList.add('fa-chevron-down');
      }
      isCodeEditorCollapsed = !isCodeEditorCollapsed;
    }

    // 运行代码
    async function runCode() {
      if (!editor) {
        alert('编辑器未初始化');
        return;
      }
      
      const code = editor.getValue();
      const outputDiv = document.getElementById('code-output');
      const executionTimeDiv = document.getElementById('execution-time');
      
      outputDiv.textContent = '正在执行...';
      
      try {
        // 简单模拟执行（不依赖Pyodide）
        const startTime = performance.now();
        await new Promise(resolve => setTimeout(resolve, 100));
        
        // 执行时间
        const endTime = performance.now();
        const executionTime = (endTime - startTime).toFixed(2);
        
        outputDiv.textContent = \`代码执行模拟完成！
-------------------
提示：本练习主要关注SQL语法和数据库设计，
可以在本地环境中安装sqlite3运行代码。

代码内容预览：
\${code.substring(0, 500)}\${code.length > 500 ? '...' : ''}\`;
        executionTimeDiv.textContent = \`执行时间：\${executionTime}ms\`;
      } catch (error) {
        outputDiv.textContent = \`执行错误：\${error.message}\`;
        executionTimeDiv.textContent = '执行时间：0ms';
      }
    }

    // 重置代码
    function resetCode() {
      const problem = problems.find(p => p.id === currentProblem);
      if (problem && editor) {
        editor.setValue(problem.code || '# 请编写代码');
        editor.clearSelection();
      }
    }

    // 切换收藏状态
    function toggleFavorite(problemId) {
      const btn = document.getElementById('favorite-btn');
      if (btn.innerHTML.includes('fa-star-o')) {
        btn.innerHTML = '<i class="fa fa-star text-yellow-400"></i>';
      } else {
        btn.innerHTML = '<i class="fa fa-star-o"></i>';
      }
    }

    // 重置计时器
    function resetTimer() {
      clearInterval(timerInterval);
      seconds = 0;
      updateTimer();
      timerInterval = setInterval(() => {
        seconds++;
        updateTimer();
      }, 1000);
    }

    // 更新计时器
    function updateTimer() {
      const minutes = Math.floor(seconds / 60);
      const secs = seconds % 60;
      document.getElementById('timer').textContent = \`\${minutes.toString().padStart(2, '0')}:\${secs.toString().padStart(2, '0')}\`;
    }

    // 滚动到指定知识点
    function scrollToKnowledge(sectionId) {
      setTimeout(() => {
        const section = document.getElementById(sectionId);
        if (section) {
          section.scrollIntoView({ behavior: 'smooth' });
        }
      }, 100);
    }

    // 更新问题项状态
    function updateProblemItemStatus(id, type) {
      document.querySelectorAll('.problem-item').forEach(item => {
        item.classList.remove('active');
      });
      const selector = type === 'choice' 
        ? \`[data-problem-id="\${id}" data-type="choice"]\`
        : \`[onclick="loadProgrammingProblem(\${id})"]\`;
      const item = document.querySelector(selector);
      if (item) {
        item.classList.add('active');
      }
    }
  </script>
</body>
</html>
